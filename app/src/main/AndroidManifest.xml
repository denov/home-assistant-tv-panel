<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Your Home Assistant server, and nothing else. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS on Wi-Fi TVs, so Home Assistant finds the TV while its TV Panel page is open. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- MessageService: the connection Home Assistant's messages arrive on, kept while other apps are in front,
         and started again at boot. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The launcher's widget row reads this provider (see the launcher's Widgets.java). -->
        <meta-data android:name="com.gathin.tvhome.widgets" android:value="com.fullstacksystems.tvpanel.widgets" />

        <activity
            android:name=".StatusActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OK on a chip that has a page: the launcher sends this action with the chip's key, and this routes it to
             the weather, solar, Apex or camera page. Their own task, so Back always returns to Home rather than to the status page. -->
        <activity
            android:name=".OpenActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.gathin.tvhome.action.OPEN_WIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- tvpanel://weather, tvpanel://solar, tvpanel://apex and tvpanel://cameras[/camera.x], so Home Assistant can open a page
                 (tv_panel.show, or remote.turn_on on the Android TV Remote integration with activity: tvpanel://weather).
                 Messages come over MessageService instead, so nothing opens for them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tvpanel" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WeatherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".ApexActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".SolarActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Opened from the grid (same task, so Back returns to it) or by voice (tvpanel://cameras/camera.x). -->
        <activity
            android:name=".CameraViewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Home Assistant's messages for this TV, as toasts over whatever is playing (see Messages.java). -->
        <service
            android:name=".MessageService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a connection to the owner's Home Assistant server so its messages show on the TV" />
        </service>

        <receiver
            android:name=".StartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".WidgetProvider"
            android:authorities="com.fullstacksystems.tvpanel.widgets"
            android:exported="true" />

        <!-- install.sh writes the server address and token here with `content write`. Only the ADB shell may. -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="${applicationId}.config"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />
    </application>
</manifest>
